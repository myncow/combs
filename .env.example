# Canonical URL for SEO, sitemap, and Open Graph (optional in dev; set in production)
SITE_URL=http://localhost:3000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=openai/gpt-4.1-mini
# Optional: dedicated chat model for POST /api/suggest-axis-pairs (defaults to OPENROUTER_MODEL)
# OPENROUTER_SUGGEST_MODEL=google/gemini-3-flash-preview
# Neon pooled URL for dev + production (Dashboard → Connection details → pooled).
DATABASE_URL=

# Neon Auth: Branch → Auth → Configuration (base URL ending in /auth)
NEON_AUTH_BASE_URL=

# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Optional: isolated URL for destructive store integration tests.
# If unset, those tests are skipped so `pnpm test` cannot wipe your dev DB.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lattice_test
SERPAPI_API_KEY=
# Optional: image-search probes during axis suggestions. Default 0 keeps typing fast.
# LATTICE_SUGGEST_SERP_PROBE_MAX_CALLS=0
